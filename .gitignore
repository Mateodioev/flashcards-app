# --- Existing project rules (kept) ---
/.idea/
/.atl/
*.cache

# --- Merged from Flutter's app template ---
# `flutter create` preserves a pre-existing .gitignore verbatim and writes none of
# its own patterns, so these must be maintained manually. See docs/plan.md T1.1a.

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws

# Flutter/Dart/Pub related
**/doc/api/
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android build artifacts (Android-only project)
/android/app/debug
/android/app/profile
/android/app/release

# Release signing: android/key.properties and android/app/*.jks never enter
# git. android/.gitignore already excludes both (key.properties, **/*.jks);
# this comment exists so the rule is documented where a reviewer looks first.
# Losing the keystore means losing the ability to update an installed app, so
# keep a backup somewhere outside this repository.

# Widget Preview related
.widget_preview/

# Flutter golden-test diff output. Regenerated on every failure; never source.
test/**/failures/
